{% extends 'base.html.twig' %}

{% block title %}Park index{% endblock %}

{% block body %}
    <h1>Park index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Country</th>
                <th>OpeningYear</th>
                <th>Nb coasters</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for park in parks %}
            <tr>
                <td>{{ park.name }}</td>
                <td>{{ park.country }}</td>
                <td>{{ park.openingYear }}</td>
                <td>{{ park.coasters|length}} </td>
                <td>
                    {% if is_granted('ROLE_USER') %}
                        <a href="{{ path('app_park_show', {'id': park.id}) }}" class="btn btn-outline-secondary">show</a>
                        <a href="{{ path('app_park_edit', {'id': park.id}) }}" class="btn btn-outline-secondary">edit</a>
                    {% endif %}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_park_new') }}" class="btn btn-outline-primary">Create new</a>
{% endblock %}
