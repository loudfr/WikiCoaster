{% extends "base.html.twig" %}

{% block body %}
<h1>Liste des coasters</h1>
<div class="d-flex justify-content-between">
    <a href="{{ path('app_coaster_add') }}" class="btn btn-secondary">Ajouter un coaster</a>


<form action="" method="get" class="d-flex justify-content-between">

    <input type='search' id='search' class='form-control' placeholder='Rechercher ...'
    class="form-control" value="{{ app.request.get('search')}}" >

    <select name="park" class="form-select ms-1">
        <option value="">Tous les parcs</option>
        {% for park in parks %}
            <option value="{{ park.id }}" {% if park.id == app.request.get('park') %}selected{% endif %}>{{ park }}</option>
        {% endfor %}
    </select>

    <select name="category" class="form-select ms-1">
        <option value="">Toutes les catégories</option>
        {% for cat in categories %}
            <option value="{{ cat.id }}" {% if cat.id == app.request.get('category') %}selected{% endif %}>{{ cat }}</option>
        {% endfor %}
    </select>

    <button type="submit" class="btn btn-outline-primary ms-1">Filtrer</button>
</form>
</div>

{% for coaster in coasters %}
<div class="card my-2">
  
    <div class="card-body">
    <!-- mettre à 2 bouts opposés -->
    <div class="d-flex justify-content-between">
        <div class="lead">{{ coaster.name }}</div>
        <div class="mx-2">{{ coaster.park }}</div>
    </div>

        <div class="infos d-flex">
            <div class="mx-2">
                Hauteur {{ coaster.maxHeight }}m
            </div>
            <div class="mx-2">
                Longueur {{ coaster.length }}m
            </div>
            <div class="mx-2">
                Vitesse max. {{ coaster.maxSpeed }}km/h
            </div>
            
        </div>
        <a href="{{ path('app_coaster_edit', {'id': coaster.id}) }}" class="btn btn-primary">Modifier</a>
        <a href="{{ path('app_coaster_delete', {'id': coaster.id}) }}" class="btn btn-danger">Supprimer</a>
    </div>
</div>
{% endfor %}
{% endblock %}