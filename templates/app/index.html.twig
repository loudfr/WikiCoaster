{% extends 'base.html.twig' %}

{% block title %}Wiki Coaster{% endblock %}

{% block body %}
<h1>Liste des coasters</h1>
<a href="{{ path('app_coaster_add') }}" class="btn btn-primary">Ajouter un coaster</a>

{{ form_start(coasterForm) }}
    {{ form_widget(coasterForm) }}
    <button type="submit" class="btn btn-primary">Ajouter</button>
{{ form_end(coasterForm) }}

{% for coaster in coasters %}
    <div class="card my-2">
        <div class="card-body">
            <div class="lead">{{ coaster.name }}</div>
            <div class="infos">
                <div class="mx-2">
                    Hauteur {{ coaster.maxHeight }}
                </div>
                <div class="mx-2">
                    Longueur {{ coaster.length }}
                </div>
                <div class="mx-2">
                    Vitesse {{ coaster.maxSpeed }}
                </div>
            </div>
        </div>
    </div>
{% endfor %}

{% endblock %}
